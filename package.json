{
  "name": "better-pr",
  "version": "0.0.5",
  "description": "Fast, filterable PR review.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run build:browser --watch\" \"bun run dev:node\"",
    "dev:node": "bun run src/node/main.ts",
    "start": "bun run build:browser && bun run src/node/main.ts",
    "typecheck": "tsgo --noEmit",
    "build:browser": "bun run ./scripts/build-browser.ts",
    "deploy": "bun run ./scripts/deploy-azure.ts",
    "fmt": "prettier --write --cache .",
    "fmt:check": "prettier --check .",
    "lint": "echo 'No linter configured yet'",
    "test": "bun test"
  },
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "diff"
  ],
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.282",
    "@hono/node-server": "^1.19.6",
    "@octokit/core": "^7.0.6",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20251201.1",
    "bun-plugin-tailwind": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "diff": "^8.0.2",
    "gitdiff-parser": "^0.3.1",
    "hono": "^4.10.7",
    "lucide-react": "^0.555.0",
    "prettier": "^3.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "refractor": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.156.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "mermaid": "^11.17.2",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gemoji": "^8.0.0",
    "vscode-diff": "^3.0.1"
  }
}
